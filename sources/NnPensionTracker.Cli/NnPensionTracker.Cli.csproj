<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>nn-pension-tracker</AssemblyName>
		<RootNamespace>DustInTheWind.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
		<Configurations>Debug;Release;Release plus Install</Configurations>
	</PropertyGroup>

	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
		<!-- .deb packaging (Packaging.Targets) -->
		<!-- PackagePrefix drives: Debian Package: field, /usr/local/bin/ command name, install dir -->
		<PackagePrefix>nn-pension-tracker</PackagePrefix>
		<PackageMaintainer>Dust in the Wind &lt;lastunicorn@users.noreply.github.com&gt;</PackageMaintainer>
		<PackageHomepage>https://github.com/lastunicorn/nn-pension-tracker</PackageHomepage>
	</PropertyGroup>

	<ItemGroup>
		<!-- Framework-dependent: net10.0 is not auto-detected by Packaging.Targets; add the runtime dep explicitly -->
		<DebDotNetDependencies Include="dotnet-runtime-10.0 | dotnet10" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Packaging.Targets" Version="0.1.232" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ConsoleTools.Commando" Version="2.1.0" />
		<PackageReference Include="ConsoleTools.Commando.Parsing" Version="2.1.0" />
		<PackageReference Include="ConsoleTools.Commando.Setup.Microsoft" Version="2.1.0" />
		<PackageReference Include="ConsoleTools.Controls.Tables" Version="1.2.1" />
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="DustInTheWind.NN.Toolkit" Version="1.5.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
		<PackageReference Include="RequestR" Version="2.2.0" />
		<PackageReference Include="RequestR.Extensions.Microsoft.DependencyInjection" Version="2.1.0" />
		<PackageReference Include="Tabula" Version="1.0.1" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="NnPensionTracker.Cli.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- Remove from the SDK's implicit None glob so we can re-declare it as Content below. -->
		<None Remove="appsettings.json" />
	</ItemGroup>

	<ItemGroup>
		<!--
		  Local dev / Windows: copy next to the binary as usual (CopyToOutputDirectory).
		  deb package (linux-x64): the LinuxPath metadata tells Packaging.Targets to
		  install the file to /etc/nn-pension-tracker/ instead of /usr/share/nn-pension-tracker/.
		-->
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<LinuxPath>/etc/nn-pension-tracker/appsettings.json</LinuxPath>
			<IsConfigFile>true</IsConfigFile>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NnPensionTracker.Cli.Presentation\NnPensionTracker.Cli.Presentation.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\NnPensionTracker.Domain\NnPensionTracker.Domain.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\NnPensionTracker.Ports.DataAccess\NnPensionTracker.Ports.DataAccess.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\NnPensionTracker.Ports.FileSystemAccess\NnPensionTracker.Ports.FileSystemAccess.csproj" PrivateAssets="All" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)..\..\LICENSE" Pack="true" PackagePath="" Link="LICENSE" />
		<None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="" Link="README.md" />
	</ItemGroup>

	<ItemGroup>
		<None Update="portable">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</None>
	</ItemGroup>

</Project>
