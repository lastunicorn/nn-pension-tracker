<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>DustInTheWind.$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>DustInTheWind.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<!-- .deb packaging (Packaging.Targets) -->
		<!-- PackagePrefix drives: Debian Package: field, /usr/local/bin/ command name, install dir -->
		<PackagePrefix>nn-pension-tracker</PackagePrefix>
		<PackageMaintainer>Dust in the Wind &lt;lastunicorn@users.noreply.github.com&gt;</PackageMaintainer>
		<PackageHomepage>https://github.com/lastunicorn/nn-pension-tracker</PackageHomepage>
		<!-- Rename the apphost binary to match the package name on linux-x64 so that
		     Packaging.Targets creates /usr/local/bin/nn-pension-tracker (not the long AssemblyName). -->
		<AssemblyName Condition="'$(RuntimeIdentifier)' == 'linux-x64'">nn-pension-tracker</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<!-- Framework-dependent: net10.0 is not auto-detected by Packaging.Targets; add the runtime dep explicitly -->
		<DebDotNetDependencies Include="dotnet-runtime-10.0 | dotnet10" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Packaging.Targets" Version="0.1.232" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ConsoleTools.Arguments" Version="1.0.0" />
		<PackageReference Include="ConsoleTools.Controls.Tables" Version="1.2.1" />
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="DustInTheWind.NN.Toolkit" Version="1.5.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
		<PackageReference Include="Tabula" Version="1.0.1" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="NnPensionTracker.Cli.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NnPensionTracker.Cli.Presentation\NnPensionTracker.Cli.Presentation.csproj" />
		<ProjectReference Include="..\NnPensionTracker.Domain\NnPensionTracker.Domain.csproj" />
		<ProjectReference Include="..\NnPensionTracker.Ports.DataAccess\NnPensionTracker.Ports.DataAccess.csproj" />
		<ProjectReference Include="..\NnPensionTracker.Ports.FileSystemAccess\NnPensionTracker.Ports.FileSystemAccess.csproj" />
	</ItemGroup>

</Project>
