<Project Sdk="WixToolset.Sdk/5.0.2">

	<PropertyGroup>
		<Configurations>Debug;Release;Release plus Install</Configurations>
		<BinariesDir>$(MSBuildThisFileDirectory)obj\BinariesStaging\</BinariesDir>
		<CliTargetDir>$(MSBuildThisFileDirectory)..\NnPensionTracker.Cli\bin\$(Configuration)\net10.0\win-x64\</CliTargetDir>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\NnPensionTracker.Cli\NnPensionTracker.Cli.csproj">
			<AdditionalProperties>RuntimeIdentifier=win-x64;SelfContained=true</AdditionalProperties>
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
		</ProjectReference>
	</ItemGroup>

	<Target Name="StageBinaries" BeforeTargets="HarvestFiles;Build">

		<ItemGroup>
			<BinariesToStage
				Include="$(CliTargetDir)**\*"
				Exclude="$(CliTargetDir)appsettings.json" />
		</ItemGroup>

		<MakeDir Directories="$(BinariesDir)" />

		<Copy
			SourceFiles="@(BinariesToStage)"
			DestinationFolder="$(BinariesDir)%(RecursiveDir)"
			SkipUnchangedFiles="true" />

	</Target>

</Project>