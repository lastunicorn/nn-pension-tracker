<Project>

	<PropertyGroup>
		<Company>Dust in the Wind</Company>
		<Product>NN Pension Tracker</Product>
		<Copyright>Copyright © 2026 Dust in the Wind</Copyright>
		<Version>1.0.1.0</Version>
		<Description>A tool for visualising the Romanian Mandatory Private Pension Fund from NN.</Description>
		<PackageTags>nn csharp mandatory-private-pension</PackageTags>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<PackageProjectUrl>https://github.com/lastunicorn/nn-pension-tracker</PackageProjectUrl>
		<RepositoryUrl>https://github.com/lastunicorn/nn-pension-tracker</RepositoryUrl>
	</PropertyGroup>

	<PropertyGroup>
		<SolutionRoot>$(MSBuildThisFileDirectory)</SolutionRoot>
	</PropertyGroup>

</Project>
